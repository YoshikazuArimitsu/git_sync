# docker compose 用の環境変数。.env にコピーして使う (.env は git 管理外)

# SSH 鍵フォルダ (省略時は ~/.ssh)
# SSH_DIR=C:/Users/you/.ssh

# 使う設定ファイル (省略時は ./git_sync.json)
# GIT_SYNC_CONFIG_FILE=./git_sync.json

# HTTPS 接続用トークン。設定ファイルの URL で ${GITHUB_TOKEN} のように参照する
# GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxx
# GITLAB_TOKEN=glpat-xxxxxxxxxxxxxxxx
